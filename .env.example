# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000/
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/pharmacy-management # Legacy reference data
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmacy?schema=public # Core operational engine (Prisma)

# Security Configuration
JWT_ACCESS_TOKEN_SECRET=your_super_secret_access_token_key
JWT_REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key
tkn_header_key=authorization

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
SENDER_MAIL=example@gmail.com
SENDER_MAIL_PASSWORD=your_app_password

# Brevo Configuration
BREVO_API_KEY=your_brevo_api_key
